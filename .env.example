# Copy to .env and adjust. Never commit .env.

# --- LLM server (any OpenAI-compatible API) ---
# Ollama (local, Mac):
LLM_BASE_URL=http://localhost:11434/v1
# Instruct variant: no hidden "thinking" (qwen3:4b spent up to 2,900 tokens thinking).
LLM_MODEL=qwen3:4b-instruct
# Ollama ignores the key, but the OpenAI client requires a non-empty value.
LLM_API_KEY=ollama

# vLLM example:
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# LLM_API_KEY=EMPTY

# Optional
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120

# --- Retrieval ---
# Qdrant server started with: docker compose -f infra/docker-compose.yml up -d qdrant
QDRANT_URL=http://localhost:6333
# Embedding model (Hugging Face id). Alternative compared in eval: BAAI/bge-m3
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Retriever for answers; variants in app/retrieval.py (BRANCHES), measured in DECISIONS
# D32 and D46. hybrid_en: dense search with the Turkish question and with its English
# translation, plus BM25 with the translation (one LLM call per question), fused with RRF.
# Without translation: dense
RETRIEVER=hybrid_en
# Cross-encoder reranker: bge_m3 | minilm_en (app/rerank.py); empty = no reranking.
# Off by default: better retrieval metrics but no measured answer gain (DECISIONS D33).
RERANKER=
RERANK_CANDIDATES=20
# Results each retriever branch returns before RRF fusion (the fused list is cut to k)
RETRIEVAL_DEPTH=20

# --- Tracing (optional, Langfuse) ---
# Local server: see infra/docker-compose.obs.yml; `uv run python infra/make_secrets.py`
# fills these in. Leave empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# --- Full eval (RAGAS judge) ---
# A larger model from another family than the answering LLM (self-preference bias).
# Runs only in the full eval, on saved answers: uv run --group eval python -m eval.full
JUDGE_MODEL=gemma3:12b
# Empty: same server as LLM_BASE_URL
JUDGE_BASE_URL=
